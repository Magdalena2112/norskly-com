  "grammar": {
   "sections": [
    {
     "title": "1.1 Indirekte spørsmål (spørreord og «om»)",
     "explanation": "Kada pitanje stavimo u zavisnu rečenicu (Kan du fortelle meg…, Jeg lurer på…, Vet du…), dobijamo indirektno pitanje. Ako pitanje ima upitnu reč (hva, hvor, når, hvor lenge), ona uvodi zavisnu rečenicu. Ako je pitanje da/ne, koristimo «om».\nVAŽNO: u indirektnom pitanju NEMA inverzije — subjekat stoji pre glagola.",
     "table": [
      [
       "Direktno",
       "Hvor gjør det vondt?"
      ],
      [
       "Indirektno",
       "Kan du vise meg hvor det gjør vondt?"
      ],
      [
       "Direktno",
       "Har du sovet godt?"
      ],
      [
       "Indirektno",
       "Jeg lurer på om du har sovet godt."
      ]
     ],
     "rules": [
      "Upitna reč (hva, hvor, når…) ili «om» uvodi indirektno pitanje.",
      "Red reči: subjekat + glagol (bez inverzije).",
      "Kad je upitna reč sama subjekat, dodaje se «som»: Vet du hvem som har vakt?"
     ],
     "compare": "Isto kao u srpskom «da li»: «Pitam se da li ste dobro spavali» → «Jeg lurer på om du har sovet godt».",
     "examples": [
      [
       "Kan du fortelle meg hva som har skjedd?",
       "Možete li mi reći šta se desilo?"
      ],
      [
       "Vet du når pasienten fikk medisinen?",
       "Znaš li kada je pacijent dobio lek?"
      ],
      [
       "Jeg lurer på om han er allergisk.",
       "Pitam se da li je alergičan."
      ]
     ],
     "mistakes": [
      [
       "Kan du si hvor gjør det vondt?",
       "Kan du si hvor det gjør vondt?",
       "U indirektnom pitanju subjekat ide pre glagola."
      ],
      [
       "Jeg lurer på hvis du har vondt.",
       "Jeg lurer på om du har vondt.",
       "Za da/ne pitanja koristi se «om», ne «hvis»."
      ]
     ]
    },
    {
     "title": "1.2 «Ikke» i leddsetninger",
     "explanation": "U zavisnoj rečenici (at, om, fordi, hvis, når…) prilozi kao ikke, alltid, aldri, ofte stoje ISPRED ličnog glagola — za razliku od glavne rečenice.",
     "table": [
      [
       "Glavna",
       "Han tåler ikke penicillin."
      ],
      [
       "Zavisna",
       "Han sier at han ikke tåler penicillin."
      ],
      [
       "Glavna",
       "Hun har aldri vært innlagt."
      ],
      [
       "Zavisna",
       "Jeg vet at hun aldri har vært innlagt."
      ]
     ],
     "rules": [
      "Zavisna rečenica: veznik + subjekat + IKKE + glagol.",
      "Isto važi za alltid, aldri, ofte, vanligvis."
     ],
     "compare": "U srpskom «ne» uvek stoji ispred glagola; u norveškom samo u zavisnoj rečenici.",
     "examples": [
      [
       "Pasienten sier at han ikke har sovet.",
       "Pacijent kaže da nije spavao."
      ],
      [
       "Ring meg hvis smertene ikke går over.",
       "Pozovi me ako bolovi ne prođu."
      ]
     ],
     "mistakes": [
      [
       "…fordi han har ikke spist.",
       "…fordi han ikke har spist.",
       "U zavisnoj rečenici «ikke» ide pre glagola."
      ]
     ]
    },
    {
     "title": "1.3 Høflige spørsmål og råd (kunne, ville, burde)",
     "explanation": "U radu sa pacijentima i kolegama koristimo preterit modalnih glagola da zvučimo ljubaznije: kunne, ville, skulle. Za savet koristimo burde (trebalo bi).",
     "table": [
      [
       "Kan du…?",
       "Kunne du…? (ljubaznije)"
      ],
      [
       "Vil du…?",
       "Ville du…? / Har du lyst til å…?"
      ],
      [
       "Du må…",
       "Du burde… (savet)"
      ]
     ],
     "rules": [
      "Kunne du + infinitiv bez «å»: Kunne du legge deg ned?",
      "Burde = preporuka, ne naredba.",
      "Jeg skulle gjerne… = ljubazna želja."
     ],
     "compare": "Kao srpski kondicional: «Da li biste mogli…?»",
     "examples": [
      [
       "Kunne du brette opp ermet?",
       "Da li biste mogli da zavrnete rukav?"
      ],
      [
       "Du burde drikke mer vann.",
       "Trebalo bi da pijete više vode."
      ],
      [
       "Jeg skulle gjerne snakke med legen.",
       "Želeo bih da razgovaram sa lekarom."
      ]
     ],
     "mistakes": [
      [
       "Kunne du å puste dypt?",
       "Kunne du puste dypt?",
       "Posle modalnog glagola nema «å»."
      ]
     ]
    }
