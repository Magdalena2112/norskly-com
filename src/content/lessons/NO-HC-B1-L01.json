{
 "code": "NO-HC-B1-L01",
 "intro": [
  {
   "id": "NO-HC-B1-L01-T01",
   "title": "Tekst 1 · Første vakt på Ullevål",
   "type": "monologue",
   "scene": "Nora, ny sykepleier, forteller om sin første uke på sykehuset i Oslo.",
   "lines": [
    {
     "speaker": "Nora",
     "text": "Hei, jeg heter Nora, og jeg har nettopp begynt som sykepleier på medisinsk avdeling på Ullevål sykehus i Oslo."
    },
    {
     "speaker": "Nora",
     "text": "Den første uka var travel, men veldig lærerik. Hver morgen starter vi med en rapport der nattevakten forteller hvordan pasientene har hatt det."
    },
    {
     "speaker": "Nora",
     "text": "Etterpå går jeg runden og måler blodtrykk, puls og temperatur. Jeg spør også pasientene om de har vondt, og om de har sovet godt."
    },
    {
     "speaker": "Nora",
     "text": "Det vanskeligste for meg er å snakke med pasienter som er redde eller forvirret. Da prøver jeg å snakke rolig, bruke enkle ord og gi dem god tid."
    },
    {
     "speaker": "Nora",
     "text": "Kollegaene mine er hjelpsomme. Hvis jeg er usikker, spør jeg Ingrid, som har jobbet på avdelingen i mange år. Hun sier alltid at det er bedre å spørre én gang for mye enn én gang for lite."
    }
   ]
  },
  {
   "id": "NO-HC-B1-L01-T02",
   "title": "Tekst 2 · Innkomstsamtale",
   "type": "dialogue",
   "scene": "Nora tar imot pasienten Per Hansen (72) som er innlagt med brystsmerter.",
   "lines": [
    {
     "speaker": "Nora",
     "text": "God dag, jeg heter Nora og er sykepleier her. Kan du fortelle meg hva som har skjedd?"
    },
    {
     "speaker": "Per",
     "text": "I natt våknet jeg med vondt i brystet, og jeg følte meg veldig kvalm."
    },
    {
     "speaker": "Nora",
     "text": "Hvor lenge har du hatt smertene? Og kan du vise meg hvor det gjør vondt?"
    },
    {
     "speaker": "Per",
     "text": "Omtrent fire timer. Det gjør vondt her, midt i brystet, og noen ganger stråler det ut i venstre arm."
    },
    {
     "speaker": "Nora",
     "text": "På en skala fra null til ti, hvor sterke er smertene nå?"
    },
    {
     "speaker": "Per",
     "text": "Kanskje seks. Det var verre i natt."
    },
    {
     "speaker": "Nora",
     "text": "Takk. Bruker du noen faste medisiner, og er du allergisk mot noe?"
    },
    {
     "speaker": "Per",
     "text": "Jeg tar blodtrykksmedisin hver morgen, og jeg tåler ikke penicillin."
    },
    {
     "speaker": "Nora",
     "text": "Det er viktig å vite. Nå skal jeg måle blodtrykket og pulsen din, og så kommer legen, Jonas, om noen minutter."
    }
   ]
  },
  {
   "id": "NO-HC-B1-L01-T03",
   "title": "Tekst 3 · Rapport ved vaktskifte",
   "type": "dialogue",
   "scene": "Ved vaktskiftet gir Nora rapport til Anne, som skal ha kveldsvakt.",
   "lines": [
    {
     "speaker": "Nora",
     "text": "Per Hansen på rom 12 ble innlagt i dag morges med brystsmerter. Han er allergisk mot penicillin."
    },
    {
     "speaker": "Anne",
     "text": "Hvordan har han det nå? Har han fortsatt vondt?"
    },
    {
     "speaker": "Nora",
     "text": "Smertene har gått ned fra seks til tre etter at han fikk smertestillende. Blodtrykket var litt høyt, 160 over 95."
    },
    {
     "speaker": "Anne",
     "text": "Vet du om legen har bestilt flere prøver?"
    },
    {
     "speaker": "Nora",
     "text": "Ja, Jonas har bestilt nye blodprøver klokka 18. Han lurer også på om pasienten bør ta EKG en gang til i kveld."
    },
    {
     "speaker": "Anne",
     "text": "Greit. Jeg følger med på blodtrykket og sier fra hvis han får mer vondt."
    }
   ]
  }
 ],
